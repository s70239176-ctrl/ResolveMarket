# Resolve frontend configuration

# Required after deploying contracts/ResolveMarket.py.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# bradbury for hosted demos, studionet for shared dev, localnet for local Studio.
NEXT_PUBLIC_NETWORK=bradbury

# Override if GenLayer changes network IDs.
NEXT_PUBLIC_CHAIN_ID=61999

# RPC used by genlayer-js when the imported chain preset is unavailable.
NEXT_PUBLIC_RPC_URL=

# Optional explorer root. The app appends /address/:address and /tx/:hash.
NEXT_PUBLIC_EXPLORER_URL=

# Official faucet URL for the selected test network.
NEXT_PUBLIC_FAUCET_URL=https://testnet-faucet.genlayer.foundation

# Owner wallet allowed to create and cancel markets.
NEXT_PUBLIC_OWNER_ADDRESS=
